---
/**
 * Üst menü: logo · menü · ürün arama · telefon. Mobilde menü <details> ile açılır (JavaScript gerekmez).
 * Menüye sadece VAR OLAN sayfaları ekle (kırık link olmasın). Yeni sayfa geldikçe MENU'ye ekle (F2.5, F2.8…).
 */
import { Image } from 'astro:assets';
import { Menu, Phone, Search, X } from '@lucide/astro';
import logo from '../assets/marka/selam-logo.png';
import { getAyarlar, telLink } from '../lib/katalog';
import { url } from '../lib/url';

const { firma } = await getAyarlar();
const MENU = [
  // K17: marka ağırlıklı — Markalar önce, ikinci menü Ürün Grupları (/urunler)
  { ad: 'Markalar', adres: url('markalar') },
  { ad: 'Ürün Grupları', adres: url('urunler') },
  { ad: 'İletişim', adres: url('iletisim') },
];

const aramaAdresi = url('ara');
const simdiki = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-stone-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4">
    <a href={url('/')} class="mr-auto shrink-0" aria-label={`${firma.kisa_ad} — ana sayfa`}>
      <Image src={logo} alt={firma.kisa_ad} height={40} densities={[1, 2, 3]} class="h-9 w-auto sm:h-10" loading="eager" />
    </a>

    <nav aria-label="Ana menü" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          MENU.map((m) => (
            <li>
              <a
                href={m.adres}
                class:list={[
                  'rounded-md px-3 py-2 font-semibold no-underline hover:bg-zemin',
                  simdiki.startsWith(m.adres) ? 'text-turuncu-koyu' : 'text-antrasit',
                ]}
              >
                {m.ad}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={aramaAdresi}
      class="inline-flex size-11 items-center justify-center rounded-md text-antrasit hover:bg-zemin"
      aria-label="Ürün ara"
      title="Ürün ara"
    >
      <Search size={22} aria-hidden="true" />
    </a>

    <a
      href={telLink(firma.telefon)}
      class="hidden min-h-11 items-center gap-2 rounded-md bg-turuncu px-4 font-semibold text-antrasit-koyu no-underline hover:bg-[#f39236] lg:inline-flex"
    >
      <Phone size={18} aria-hidden="true" />
      {firma.telefon}
    </a>

    <details class="group relative md:hidden">
      <summary
        class="inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-md hover:bg-zemin [&::-webkit-details-marker]:hidden"
        aria-label="Menüyü aç/kapat"
      >
        <Menu size={24} class="group-open:hidden" aria-hidden="true" />
        <X size={24} class="hidden group-open:block" aria-hidden="true" />
      </summary>
      <nav
        aria-label="Mobil menü"
        class="absolute right-0 mt-2 w-56 rounded-lg border border-stone-200 bg-white p-2 shadow-lg"
      >
        <ul>
          {
            MENU.map((m) => (
              <li>
                <a href={m.adres} class="block rounded-md px-3 py-3 font-semibold text-antrasit no-underline hover:bg-zemin">
                  {m.ad}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
