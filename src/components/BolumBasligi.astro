---
/** Bölüm başlığı: turuncu vurgu çizgisi + başlık + isteğe bağlı açıklama ve "tümü" linki. */
import { ArrowRight } from '@lucide/astro';

interface Props {
  baslik: string;
  aciklama?: string;
  linkMetni?: string;
  linkAdresi?: string;
  /** başlık seviyesi (sayfa yapısına göre) */
  seviye?: 'h1' | 'h2' | 'h3';
}
const { baslik, aciklama, linkMetni, linkAdresi, seviye = 'h2' } = Astro.props;
const Etiket = seviye;
---

<div class="mb-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <div>
    <span class="mb-2 block h-1 w-10 rounded-full bg-turuncu" aria-hidden="true"></span>
    <Etiket class:list={[seviye === 'h1' ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl']}>{baslik}</Etiket>
    {aciklama && <p class="mt-1 max-w-2xl text-stone-600">{aciklama}</p>}
  </div>
  {
    linkMetni && linkAdresi && (
      <a href={linkAdresi} class="inline-flex items-center gap-1 font-semibold text-turuncu-koyu hover:underline">
        {linkMetni}
        <ArrowRight size={18} aria-hidden="true" />
      </a>
    )
  }
</div>
