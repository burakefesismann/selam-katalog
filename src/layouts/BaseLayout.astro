---
import '../styles/global.css';
import MobilAltCubuk from '../components/MobilAltCubuk.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { icerigiDogrula } from '../lib/katalog';

// Eksik referans, slug/dosya adı uyuşmazlığı vb. varsa derlemeyi anlaşılır bir hatayla durdurur.
await icerigiDogrula();

interface Props {
  title: string;
  description?: string;
  /** arama motorlarında gösterme (ör. /stil-rehberi) */
  noindex?: boolean;
}

const { title, description = 'Selam İnşaat ürün kataloğu — Rize', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#2b2a29" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col pb-20 md:pb-0">
    <a
      href="#icerik"
      class="sr-only z-50 rounded bg-turuncu px-4 py-2 font-semibold text-antrasit-koyu focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >İçeriğe geç</a
    >
    <SiteHeader />
    <div id="icerik" class="flex-1">
      <slot />
    </div>
    <SiteFooter />
    <MobilAltCubuk />
  </body>
</html>
