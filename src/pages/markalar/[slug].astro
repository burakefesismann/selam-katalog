---
/**
 * Marka detay (F2.5, K17 marka ağırlıklı): büyük tanıtım görseli (varsa) + logo, tanıtım, web sitesi;
 * markanın ürün gruplarına hızlı geçiş; ürünler ANA ürün grubuna göre bölüm bölüm.
 */
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { ExternalLink, Phone } from '@lucide/astro';
import BolumBasligi from '../../components/BolumBasligi.astro';
import Buton from '../../components/Buton.astro';
import KonumYolu from '../../components/KonumYolu.astro';
import MarkaLogosu from '../../components/MarkaLogosu.astro';
import UrunKarti from '../../components/UrunKarti.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  anaKategoriyeGoreGrupla,
  getAyarlar,
  getMarkalar,
  getMarkaUrunleri,
  getUrunDetay,
  telLink,
  type Marka,
} from '../../lib/katalog';
import { markdownHtml } from '../../lib/markdown';
import { kategoriUrl, url } from '../../lib/url';

export const getStaticPaths = (async () => {
  return (await getMarkalar()).map((marka) => ({ params: { slug: marka.id }, props: { marka } }));
}) satisfies GetStaticPaths;

interface Props {
  marka: Marka;
}
const { marka } = Astro.props;
const { data } = marka;
const { firma } = await getAyarlar();
const urunler = await getMarkaUrunleri(marka.id);
const gruplar = await Promise.all(
  (await anaKategoriyeGoreGrupla(urunler)).map(async (g) => ({
    kategori: g.kategori,
    kartlar: await Promise.all(
      g.urunler.map(async (urun) => {
        const d = await getUrunDetay(urun);
        // Kartta bu markayı göster (çok markalı üründe ana marka başka olabilir)
        return { urun, marka, kategoriAdi: d.kategori.data.ad };
      }),
    ),
  })),
);
const tanitim = markdownHtml(data.aciklama);
const webAdi = data.web_sitesi?.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
let sira = 0;
// Arama sonucunda logo (SVG olduğu gibi; diğerleri küçük WebP)
const logoKucuk = !data.logo || typeof data.logo === 'string'
  ? undefined
  : data.logo.format === 'svg'
    ? data.logo.src
    : (await getImage({ src: data.logo, width: 160, format: 'webp' })).src;
---

<BaseLayout title={`${data.ad} — ${firma.kisa_ad}`} description={data.kisa_aciklama}>
  <main class="mx-auto max-w-6xl px-4 py-8">
    <KonumYolu ogeler={[{ ad: 'Markalar', adres: url('markalar') }, { ad: data.ad }]} />

    {
      data.one_cikan_gorsel && typeof data.one_cikan_gorsel !== 'string' && (
        <div class="mb-6 overflow-hidden rounded-lg bg-zemin">
          <Image
            src={data.one_cikan_gorsel}
            alt={`${data.ad} ürünleri`}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1152px) 1152px, 100vw"
            loading="eager"
            class="aspect-[21/9] w-full object-cover"
          />
        </div>
      )
    }

    <header data-pagefind-body class="mb-10 grid items-center gap-6 rounded-lg border border-stone-200 p-5 sm:grid-cols-[auto_1fr] sm:p-8">
      <div class="flex h-24 items-center justify-center sm:h-28 sm:w-56">
        <MarkaLogosu marka={marka} yukseklik={96} class="max-h-20 max-w-full sm:max-h-24" />
      </div>
      <div>
        <span hidden data-pagefind-filter="tür:Marka"></span>
        {logoKucuk && <span hidden data-pagefind-meta={`image:${logoKucuk}`}></span>}
        <h1 class="text-3xl sm:text-4xl">{data.ad}</h1>
        <p class="mt-2 text-lg text-stone-700">{data.kisa_aciklama}</p>
        {
          data.web_sitesi && (
            <a
              href={data.web_sitesi}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-flex items-center gap-1 font-semibold text-turuncu-koyu hover:underline"
            >
              {webAdi}
              <ExternalLink size={16} aria-hidden="true" />
            </a>
          )
        }
      </div>
    </header>

    {
      tanitim && (
        <section class="mb-12" data-pagefind-body>
          <BolumBasligi baslik={`${data.ad} hakkında`} />
          <div class="icerik" set:html={tanitim} />
        </section>
      )
    }

    {
      gruplar.length === 0 ? (
        <div class="rounded-lg border border-dashed border-stone-300 bg-zemin p-8 text-center">
          <p class="font-baslik text-xl font-bold">{data.ad} ürünleri hazırlanıyor</p>
          <p class="mt-2 text-stone-600">Bilgi almak için bizi arayın.</p>
          <div class="mt-4">
            <Buton href={telLink(firma.telefon)}>
              <Phone size={18} aria-hidden="true" />
              {firma.telefon}
            </Buton>
          </div>
        </div>
      ) : (
        <div class="space-y-12">
          {gruplar.length > 1 && (
            <nav aria-label={`${data.ad} ürün grupları`} class="-mt-4">
              <ul class="flex flex-wrap gap-2">
                {gruplar.map(({ kategori, kartlar }) => (
                  <li>
                    <a
                      href={`#${kategori.id}`}
                      class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-stone-300 bg-white px-3 text-sm font-semibold text-antrasit hover:border-turuncu hover:text-turuncu-koyu"
                    >
                      {kategori.data.ad}
                      <span class="text-xs font-normal text-stone-500">{kartlar.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          {gruplar.map(({ kategori, kartlar }) => (
            <section id={kategori.id} class="scroll-mt-24">
              <BolumBasligi
                baslik={kategori.data.ad}
                linkMetni="Kategoriye git"
                linkAdresi={kategoriUrl(kategori.id)}
              />
              <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
                {kartlar.map((k) => (
                  <li class="flex">
                    <UrunKarti {...k} oncelikli={sira++ < 4} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
