---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Selam İnşaat — Ürün Kataloğu">
  <main class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center gap-4 px-4 text-center">
    <p class="text-sm font-semibold tracking-wide text-orange-700 uppercase">Selam İnşaat · Rize</p>
    <h1 class="text-3xl font-bold sm:text-4xl">Ürün kataloğumuz yakında burada</h1>
    <p class="text-neutral-600">
      Yapı malzemelerinde 50 yıllık tecrübemizle ürünlerimizi tanıtacağımız katalog hazırlanıyor.
    </p>
    <a
      href="tel:+904642176067"
      class="mt-2 rounded-md bg-neutral-900 px-5 py-3 font-semibold text-white hover:bg-neutral-700"
    >
      Bilgi için arayın: 0 (464) 217 60 67
    </a>
  </main>
</BaseLayout>
