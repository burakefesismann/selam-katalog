---
/**
 * Ana sayfa (F2.2, K12): dengeli genel görünüm, tek bir kategori büyütülmez.
 * Sıra (K17, marka ağırlıklı): arama + güven mesajı → marka vitrini (Fırat ilk ve vurgulu) → ürün grupları (eşit kartlar)
 * → farklı kategorilerden öne çıkan ürünler → [çözüm sayfaları: F4.5'e kadar gizli] → şubeler/iletişim.
 */
import { Image } from 'astro:assets';
import { Clock, MapPin, Phone, Search, ShieldCheck } from '@lucide/astro';
import BolumBasligi from '../components/BolumBasligi.astro';
import Buton from '../components/Buton.astro';
import KategoriKarti from '../components/KategoriKarti.astro';
import UrunKarti from '../components/UrunKarti.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAnaKategoriler,
  getAyarlar,
  getKategoriGorseli,
  getKategoriUrunleri,
  getMarkalar,
  getOneCikanUrunler,
  getUrunDetay,
  telLink,
} from '../lib/katalog';
import { kategoriUrl, markaUrl, url } from '../lib/url';

const { firma, subeler, ana_sayfa } = await getAyarlar();

const kategoriler = await Promise.all(
  (await getAnaKategoriler()).map(async (kategori) => {
    const urunSayisi = (await getKategoriUrunleri(kategori.id)).length;
    return {
      kategori,
      urunSayisi,
      gorsel: await getKategoriGorseli(kategori),
      adres: kategoriUrl(kategori.id),
    };
  }),
);

const markalar = await getMarkalar(); // sira'ya göre: Fırat sira 1 → ilk (K12)
const VURGULU_MARKA = 'firat';

const oneCikanlar = await Promise.all(
  (await getOneCikanUrunler(8)).map(async (urun) => {
    const d = await getUrunDetay(urun);
    return { urun, marka: d.markalar[0], kategoriAdi: d.kategori.data.ad };
  }),
);


const aramaAdresi = url('ara');
---

<BaseLayout
  title={`${firma.kisa_ad} — Ürün Kataloğu · ${firma.sehir}`}
  description={ana_sayfa.alt_baslik ?? `${firma.kisa_ad} yapı malzemeleri ürün kataloğu`}
>
  <main>
    <!-- 1. Arama + güven mesajı -->
    <section class="bg-antrasit text-white">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
        {
          ana_sayfa.guven_mesaji && (
            <p class="mb-4 inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm font-semibold text-turuncu ring-1 ring-white/25">
              <ShieldCheck size={16} aria-hidden="true" />
              {ana_sayfa.guven_mesaji}
            </p>
          )
        }
        <h1 class="max-w-3xl text-4xl text-white sm:text-5xl">{ana_sayfa.baslik}</h1>
        {ana_sayfa.alt_baslik && <p class="mt-3 max-w-2xl text-lg text-stone-300">{ana_sayfa.alt_baslik}</p>}

        <form action={aramaAdresi} method="get" role="search" class="mt-8 flex max-w-xl gap-2">
          <label for="ana-arama" class="sr-only">Ürün, marka ya da kategori ara</label>
          <div class="relative flex-1">
            <Search
              size={20}
              class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-stone-500"
              aria-hidden="true"
            />
            <input
              id="ana-arama"
              name="q"
              type="search"
              placeholder="Ürün ya da marka ara"
              class="min-h-12 w-full rounded-md border-0 bg-white pr-3 pl-10 text-antrasit placeholder:text-stone-500"
            />
          </div>
          <Buton type="submit" boyut="buyuk" class="min-h-12">Ara</Buton>
        </form>

        <p class="mt-6 text-stone-300">
          Bilgi almak için:
          <a href={telLink(firma.telefon)} class="font-semibold text-turuncu hover:underline">{firma.telefon}</a>
        </p>
      </div>
    </section>

    <!-- 2. Marka vitrini (K17: marka ağırlıklı; sira'ya göre, Fırat ilk ve vurgulu) -->
    {
      markalar.length > 0 && (
        <section class="mx-auto max-w-6xl px-4 pt-12">
          <BolumBasligi baslik="Markalarımız" aciklama="Çalıştığımız markaların ürünlerini marka marka inceleyin." linkMetni="Tüm markalar" linkAdresi={url('markalar')} />
          <ul class="flex flex-wrap items-stretch gap-3">
            {markalar.map((m) => {
              const vurgulu = m.id === VURGULU_MARKA;
              return (
                <li class="flex">
                <a
                  href={markaUrl(m.id)}
                  class:list={[
                    'flex items-center justify-center rounded-lg border bg-white px-5 transition-shadow hover:shadow-md',
                    vurgulu
                      ? 'h-24 min-w-48 border-turuncu ring-2 ring-turuncu/40 sm:h-28 sm:min-w-60'
                      : 'h-20 min-w-36 border-stone-200 sm:h-24 sm:min-w-44',
                  ]}
                  title={`${m.data.ad} ürünleri`}
                >
                  {m.data.logo && typeof m.data.logo !== 'string' ? (
                    <Image
                      src={m.data.logo}
                      alt={m.data.ad}
                      height={vurgulu ? 64 : 48}
                      class:list={['w-auto object-contain', vurgulu ? 'max-h-14 sm:max-h-16' : 'max-h-10 sm:max-h-12']}
                    />
                  ) : (
                    <span class="font-baslik text-xl font-bold text-antrasit">{m.data.ad}</span>
                  )}
                </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <!-- 3. Ürün grupları (eşit kartlar) -->
    <section class="mx-auto max-w-6xl px-4 pt-14">
      <BolumBasligi baslik="Ürün Grupları" aciklama="Aynı tür ürünler bir arada: tesisattan boyaya ihtiyacınız olan grubu seçin." linkMetni="Tüm ürün grupları" linkAdresi={url('urunler')} />
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
        {
          kategoriler.map((k, i) => (
            <li class="flex">
              <KategoriKarti {...k} oncelikli={i < 4} />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 4. Öne çıkan ürünler (farklı kategorilerden) -->
    {
      oneCikanlar.length > 0 && (
        <section class="mx-auto max-w-6xl px-4 pt-14">
          <BolumBasligi baslik="Öne çıkan ürünler" linkMetni="Tüm ürünler" linkAdresi={url('urunler')} />
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
            {oneCikanlar.map((k) => (
              <li class="flex">
                <UrunKarti {...k} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- 5. Çözüm sayfaları: F4.5'te açılacak (K13) -->

    <!-- 6. Şubeler / iletişim özeti -->
    <section class="mt-14 bg-zemin">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <BolumBasligi
          baslik="Mağazalarımız"
          aciklama="Ürünler hakkında bilgi almak için arayın ya da mağazalarımıza uğrayın."
        />
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            subeler.map((s) => (
              <li class="flex flex-col gap-2 rounded-lg border border-stone-200 bg-white p-5">
                <h3 class="text-xl">{s.ad}</h3>
                <p class="flex gap-2 text-sm text-stone-700">
                  <MapPin size={18} class="mt-0.5 shrink-0 text-turuncu-koyu" aria-hidden="true" />
                  {s.adres}
                </p>
                {s.calisma_saatleri && (
                  <p class="flex gap-2 text-sm text-stone-700">
                    <Clock size={18} class="mt-0.5 shrink-0 text-turuncu-koyu" aria-hidden="true" />
                    {s.calisma_saatleri}
                  </p>
                )}
                {s.telefon && (
                  <div class="mt-auto pt-2">
                    <Buton href={telLink(s.telefon)} tur="ikincil" boyut="kucuk">
                      <Phone size={16} aria-hidden="true" />
                      {s.telefon}
                    </Buton>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
