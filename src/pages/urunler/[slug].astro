---
/**
 * Ürün detay sayfası (F2.4). SADECE DOLU bölümler görünür.
 * kart_tipi'ne göre vurgu (sağ sütunda öne çıkan blok):
 *   grup → ölçüler/ambalajlar · marka_tur → seriler/modeller · urun → teknik özellik tablosu
 * Diğer dolu bölümler altta. Karşılaştırma tablosu F2.6'da kategori sayfasına gelecek.
 */
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import { Check, FileText, Phone, Table2 } from '@lucide/astro';
import BolumBasligi from '../../components/BolumBasligi.astro';
import Buton from '../../components/Buton.astro';
import KonumYolu from '../../components/KonumYolu.astro';
import KullanimAlaniIkon from '../../components/KullanimAlaniIkon.astro';
import Rozet from '../../components/Rozet.astro';
import UrunGalerisi from '../../components/UrunGalerisi.astro';
import UrunKarti from '../../components/UrunKarti.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAyarlar,
  getKategoriUrunleri,
  getKategoriYolu,
  getUrunDetay,
  getUrunler,
  kategoriKarsilastirmasi,
  telLink,
  type Urun,
} from '../../lib/katalog';
import { kategoriUrl, markaUrl, url } from '../../lib/url';

export const getStaticPaths = (async () => {
  return (await getUrunler()).map((urun) => ({ params: { slug: urun.id }, props: { urun } }));
}) satisfies GetStaticPaths;

interface Props {
  urun: Urun;
}

const { urun } = Astro.props;
const { data } = urun;
const { kategori, markalar, kullanimAlanlari, teknikOzellikler, ilgiliUrunler } = await getUrunDetay(urun);
const kategoriYolu = await getKategoriYolu(kategori.id);
const { firma } = await getAyarlar();
const { Content } = await render(urun);
const aciklamaVar = Boolean(urun.body?.trim());
const anaMarka = markalar[0];

// Arama (F2.7): sonuçta küçük görsel + kategori yolu aranabilir olsun
const ilk = data.gorseller[0];
const aramaGorseli = ilk && typeof ilk.gorsel !== 'string' ? (await getImage({ src: ilk.gorsel, width: 160, format: 'webp' })).src : undefined;
// Paylaşım görseli (WhatsApp/Facebook): JPG en uyumlusu
const paylasimGorseli =
  ilk && typeof ilk.gorsel !== 'string'
    ? (await getImage({ src: ilk.gorsel, width: Math.min(ilk.gorsel.width, 1200), format: 'jpg', background: '#ffffff' })).src
    : undefined;

const modelGorseliVar = data.modeller.some((m) => m.gorsel);
const modelAciklamaVar = data.modeller.some((m) => m.aciklama);

const KART_TIPI = { seri: 'Seri', grup: 'Ürün ailesi', marka_tur: 'Marka serisi', urun: 'Ürün' } as const;
const tip = data.kart_tipi;

// Sağ sütunda vurgulanan blok (kart tipine göre); dolu değilse gösterilmez ve alta da düşmez
const vurgu = tip === 'grup' ? 'olculer' : tip === 'marka_tur' || tip === 'seri' ? 'seriler' : 'teknik';
const dolu = {
  olculer: data.olculer.length > 0,
  seriler: data.seriler.length > 0,
  teknik: teknikOzellikler.length > 0,
};

// Bu ürün kendi kategorisinin karşılaştırma tablosunda mı (F2.6)
const karsilastirma = await kategoriKarsilastirmasi(kategori.id);
const karsilastirAdresi = karsilastirma?.urunler.some((u) => u.id === urun.id)
  ? `${kategoriUrl(kategori.id)}#karsilastirma`
  : undefined;

// İlgili ürünler; yoksa aynı kategoriden en fazla 4 ürün
let ilgiliBaslik = 'İlgili ürünler';
let ilgili = ilgiliUrunler;
if (ilgili.length === 0) {
  ilgili = (await getKategoriUrunleri(kategori.id)).filter((u) => u.id !== urun.id).slice(0, 4);
  ilgiliBaslik = `${kategori.data.ad}: diğer ürünler`;
}
const ilgiliKartlar = await Promise.all(
  ilgili.map(async (u) => {
    const d = await getUrunDetay(u);
    return { urun: u, marka: d.markalar[0], kategoriAdi: d.kategori.data.ad };
  }),
);

---

<BaseLayout title={`${data.ad} — ${firma.kisa_ad}`} description={data.kisa_aciklama} ogImage={paylasimGorseli} ogType="product">
  <main class="mx-auto max-w-6xl px-4 py-8" data-pagefind-body>
    <span hidden data-pagefind-filter="tür:Ürün"></span>
    {aramaGorseli && <span hidden data-pagefind-meta={`image:${aramaGorseli}`}></span>}
    {ilk && <span hidden data-pagefind-meta={`image_alt:${ilk.alt_metin}`}></span>}
    <span class="sr-only">Kategori: {kategoriYolu.map((k) => k.data.ad).join(', ')}.</span>
    <div data-pagefind-ignore>
    <KonumYolu
      ogeler={[
        ...kategoriYolu.map((k) => ({ ad: k.data.ad, adres: kategoriUrl(k.id) })),
        { ad: data.ad },
      ]}
    />
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
      <UrunGalerisi urun={urun} marka={anaMarka} kategoriAdi={kategori.data.ad} />

      <div class="flex flex-col gap-5">
        <span class="sr-only">Marka: {markalar.map((m) => m.data.ad).join(', ') || 'Çeşitli markalar'}.</span>
        <div class="flex flex-wrap gap-2" data-pagefind-ignore>
          {
            markalar.map((m) => (
              <a href={markaUrl(m.id)} class="no-underline hover:opacity-80">
                <Rozet tur="turuncu">{m.data.ad}</Rozet>
              </a>
            ))
          }
          {markalar.length === 0 && <Rozet tur="turuncu">Çeşitli markalar</Rozet>}
          <Rozet>{KART_TIPI[tip]}</Rozet>
        </div>

        <div>
          <h1 class="text-3xl sm:text-4xl">{data.ad}</h1>
          <p class="mt-3 text-lg text-stone-700">{data.kisa_aciklama}</p>
        </div>

        {
          data.one_cikanlar.length > 0 && (
            <ul class="grid gap-2 sm:grid-cols-2">
              {data.one_cikanlar.map((m) => (
                <li class="flex items-start gap-2">
                  <Check size={20} class="mt-0.5 shrink-0 text-turuncu-koyu" aria-hidden="true" />
                  <span class="font-medium">{m}</span>
                </li>
              ))}
            </ul>
          )
        }

        {
          kullanimAlanlari.length > 0 && (
            <div>
              <h2 class="mb-2 text-base font-semibold text-stone-600">Kullanım alanları</h2>
              <div class="flex flex-wrap gap-2">
                {kullanimAlanlari.map((a) => (
                  <KullanimAlaniIkon alan={a} />
                ))}
              </div>
            </div>
          )
        }

        <!-- Kart tipine göre vurgulanan blok -->
        {
          vurgu === 'olculer' && dolu.olculer && (
            <div class="rounded-lg bg-zemin p-4">
              <h2 class="mb-2 text-xl">Mevcut ölçüler</h2>
              <ul class="flex flex-wrap gap-2">
                {data.olculer.map((o) => (
                  <li class="rounded-md border border-stone-300 bg-white px-3 py-1.5 font-semibold">{o}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          vurgu === 'seriler' && dolu.seriler && (
            <div class="rounded-lg bg-zemin p-4">
              <h2 class="mb-2 text-xl">Seriler / modeller</h2>
              <ul class="flex flex-wrap gap-2">
                {data.seriler.map((s) => (
                  <li class="rounded-md border border-stone-300 bg-white px-3 py-1.5 font-semibold">{s}</li>
                ))}
              </ul>
              {data.gorseller.length > 1 && (
                <p class="mt-2 text-sm text-stone-600">Görseller seriden örneklerdir; tüm modeller için bizi arayın.</p>
              )}
            </div>
          )
        }
        {
          vurgu === 'teknik' && dolu.teknik && (
            <div class="rounded-lg border border-stone-200">
              <h2 class="border-b border-stone-200 bg-zemin px-4 py-2 text-xl">Teknik özellikler</h2>
              <table class="w-full text-left text-sm">
                <tbody>
                  {teknikOzellikler.map(({ ozellik, deger }) => (
                    <tr class="border-b border-stone-100 last:border-0">
                      <th scope="row" class="w-1/2 px-4 py-2 font-medium text-stone-600">
                        {ozellik.data.ad}
                      </th>
                      <td class="px-4 py-2 font-semibold">
                        {deger}
                        {ozellik.data.birim && ` ${ozellik.data.birim}`}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        <div class="flex flex-wrap gap-3 pt-1" data-pagefind-ignore>
          <Buton href={telLink(firma.telefon)} boyut="buyuk">
            <Phone size={20} aria-hidden="true" />
            Bilgi almak için arayın
          </Buton>
          {
            data.teknik_foy && (
              <Buton href={url(data.teknik_foy)} tur="cerceve" boyut="buyuk" target="_blank">
                <FileText size={20} aria-hidden="true" />
                Teknik föy (PDF)
              </Buton>
            )
          }
        </div>
        <p class="text-sm text-stone-600" data-pagefind-ignore>
          {firma.telefon} · Fiyat ve stok bilgisi için mağazalarımızı arayın.
        </p>
        {
          karsilastirAdresi && (
            <a href={karsilastirAdresi} class="inline-flex items-center gap-2 font-semibold text-turuncu-koyu hover:underline">
              <Table2 size={18} aria-hidden="true" />
              Benzer ürünlerle karşılaştır
            </a>
          )
        }
      </div>
    </div>

    <!-- Alt bölümler: vurgulanmayan dolu bilgiler -->
    <div class="mt-12 space-y-12">
      {
        data.modeller.length > 0 && (
          <section id="modeller" class="scroll-mt-24">
            <BolumBasligi baslik="Modeller" aciklama={`${data.modeller.length} model`} />
            <div class="overflow-x-auto rounded-lg border border-stone-200">
              <table class="w-full text-left text-sm">
                <thead class="bg-zemin text-stone-600">
                  <tr>
                    {modelGorseliVar && <th scope="col" class="w-20 px-3 py-2"><span class="sr-only">Görsel</span></th>}
                    <th scope="col" class="px-3 py-2 font-semibold">Ürün kodu</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Model</th>
                    <th scope="col" class="hidden px-3 py-2 font-semibold sm:table-cell">Ölçü / ambalaj</th>
                    {modelAciklamaVar && <th scope="col" class="hidden px-3 py-2 font-semibold sm:table-cell">Açıklama</th>}
                  </tr>
                </thead>
                <tbody>
                  {data.modeller.map((m) => (
                    <tr class="border-t border-stone-200">
                      {modelGorseliVar && (
                        <td class="px-3 py-2">
                          {m.gorsel && typeof m.gorsel !== 'string' ? (
                            <Image src={m.gorsel} alt={m.ad} width={64} height={64} class="h-14 w-14 rounded bg-zemin object-contain" />
                          ) : null}
                        </td>
                      )}
                      <td class="px-3 py-2 font-mono text-xs whitespace-nowrap text-stone-700">{m.kod ?? '—'}</td>
                      <th scope="row" class="px-3 py-2 font-semibold text-antrasit">
                        {m.ad}
                        {(m.olcu || m.aciklama) && (
                          <span class="mt-0.5 block text-xs font-normal text-stone-600 sm:hidden">
                            {[m.olcu, m.aciklama].filter(Boolean).join(' · ')}
                          </span>
                        )}
                      </th>
                      <td class="hidden px-3 py-2 whitespace-nowrap sm:table-cell">{m.olcu ?? '—'}</td>
                      {modelAciklamaVar && <td class="hidden px-3 py-2 text-stone-600 sm:table-cell">{m.aciklama ?? ''}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        aciklamaVar && (
          <section>
            <BolumBasligi baslik="Ürün hakkında" />
            <div class="icerik">
              <Content />
            </div>
          </section>
        )
      }

      {
        vurgu !== 'teknik' && dolu.teknik && (
          <section>
            <BolumBasligi baslik="Teknik özellikler" />
            <table class="w-full max-w-3xl text-left text-sm">
              <tbody>
                {teknikOzellikler.map(({ ozellik, deger }) => (
                  <tr class="border-b border-stone-200">
                    <th scope="row" class="w-1/2 py-2 pr-4 font-medium text-stone-600">
                      {ozellik.data.ad}
                    </th>
                    <td class="py-2 font-semibold">
                      {deger}
                      {ozellik.data.birim && ` ${ozellik.data.birim}`}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      {
        vurgu !== 'olculer' && dolu.olculer && (
          <section>
            <BolumBasligi baslik="Ölçüler / ambalajlar" />
            <ul class="flex flex-wrap gap-2">
              {data.olculer.map((o) => (
                <li class="rounded-md border border-stone-300 px-3 py-1.5 font-semibold">{o}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        vurgu !== 'seriler' && dolu.seriler && (
          <section>
            <BolumBasligi baslik="Seriler / modeller" />
            <ul class="flex flex-wrap gap-2">
              {data.seriler.map((s) => (
                <li class="rounded-md border border-stone-300 px-3 py-1.5 font-semibold">{s}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        ilgiliKartlar.length > 0 && (
          <section data-pagefind-ignore>
            <BolumBasligi
              baslik={ilgiliBaslik}
              linkMetni={`${kategori.data.ad} kategorisi`}
              linkAdresi={kategoriUrl(kategori.id)}
            />
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
              {ilgiliKartlar.map((k) => (
                <li class="flex">
                  <UrunKarti {...k} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>
