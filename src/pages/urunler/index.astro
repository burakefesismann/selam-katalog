---
/** Tüm ürünler: ana kategorilere göre bölümler, her bölüm kategori sayfasına bağlanır. */
import BolumBasligi from '../../components/BolumBasligi.astro';
import UrunKarti from '../../components/UrunKarti.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAnaKategoriler, getAyarlar, getKategoriUrunleri, getUrunDetay } from '../../lib/katalog';
import { kategoriUrl } from '../../lib/url';

const { firma } = await getAyarlar();
const bolumler = (
  await Promise.all(
    (await getAnaKategoriler()).map(async (kategori) => ({
      kategori,
      kartlar: await Promise.all(
        (await getKategoriUrunleri(kategori.id)).map(async (urun) => {
          const d = await getUrunDetay(urun);
          return { urun, marka: d.markalar[0], kategoriAdi: d.kategori.data.ad };
        }),
      ),
    })),
  )
).filter((b) => b.kartlar.length > 0);
const toplam = bolumler.reduce((t, b) => t + b.kartlar.length, 0);
let sira = 0;
---

<BaseLayout title={`Ürünler — ${firma.kisa_ad}`} description={`${firma.kisa_ad} ürün kataloğu: ${toplam} ürün.`}>
  <main class="mx-auto max-w-6xl space-y-12 px-4 py-8">
    <BolumBasligi seviye="h1" baslik="Ürünler" aciklama={`${toplam} ürün`} />
    {
      bolumler.map(({ kategori, kartlar }) => (
        <section id={kategori.id} class="scroll-mt-24">
          <BolumBasligi
            baslik={kategori.data.ad}
            linkMetni={`${kategori.data.ad} sayfası`}
            linkAdresi={kategoriUrl(kategori.id)}
          />
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
            {kartlar.map((k) => (
              <li class="flex">
                <UrunKarti {...k} oncelikli={sira++ < 4} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</BaseLayout>
