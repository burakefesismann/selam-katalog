---
/**
 * Ürün Grupları (K17: ikinci menü; adres /urunler korunur — QR ve eski linkler bozulmasın).
 * Üstte gruplara hızlı geçiş, altında ana ürün grupları bölüm bölüm; her bölüm ürün grubu sayfasına bağlanır.
 */
import BolumBasligi from '../../components/BolumBasligi.astro';
import UrunKarti from '../../components/UrunKarti.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAnaKategoriler, getAyarlar, getKategoriUrunleri, getUrunDetay } from '../../lib/katalog';
import { FileDown } from '@lucide/astro';
import Buton from '../../components/Buton.astro';
import { kategoriUrl, katalogPdfUrl } from '../../lib/url';

const { firma } = await getAyarlar();
const bolumler = (
  await Promise.all(
    (await getAnaKategoriler()).map(async (kategori) => ({
      kategori,
      kartlar: await Promise.all(
        (await getKategoriUrunleri(kategori.id)).map(async (urun) => {
          const d = await getUrunDetay(urun);
          return { urun, marka: d.markalar[0], kategoriAdi: d.kategori.data.ad };
        }),
      ),
    })),
  )
).filter((b) => b.kartlar.length > 0);
const toplam = bolumler.reduce((t, b) => t + b.kartlar.length, 0);
let sira = 0;
---

<BaseLayout
  title={`Ürün Grupları — ${firma.kisa_ad}`}
  description={`${firma.kisa_ad} ürün kataloğu: ${bolumler.length} ürün grubu, ${toplam} ürün.`}
>
  <main class="mx-auto max-w-6xl space-y-12 px-4 py-8">
    <div>
      <div class="flex flex-wrap items-end justify-between gap-3">
        <BolumBasligi
          seviye="h1"
          baslik="Ürün Grupları"
          aciklama={`Aynı tür ürünler bir arada: ${bolumler.length} grup, ${toplam} ürün.`}
        />
        <Buton href={katalogPdfUrl()} tur="cerceve" boyut="kucuk" class="mb-5">
          <FileDown size={16} aria-hidden="true" /> Kataloğu indir (PDF)
        </Buton>
      </div>
      <nav aria-label="Ürün gruplarına git">
        <ul class="flex flex-wrap gap-2">
          {
            bolumler.map(({ kategori, kartlar }) => (
              <li>
                <a
                  href={`#${kategori.id}`}
                  class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-stone-300 bg-white px-3 text-sm font-semibold text-antrasit hover:border-turuncu hover:text-turuncu-koyu"
                >
                  {kategori.data.ad}
                  <span class="text-xs font-normal text-stone-500">{kartlar.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    {
      bolumler.map(({ kategori, kartlar }) => (
        <section id={kategori.id} class="scroll-mt-24">
          <BolumBasligi
            baslik={kategori.data.ad}
            linkMetni={`${kategori.data.ad} sayfası`}
            linkAdresi={kategoriUrl(kategori.id)}
          />
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
            {kartlar.map((k) => (
              <li class="flex">
                <UrunKarti {...k} oncelikli={sira++ < 4} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</BaseLayout>
