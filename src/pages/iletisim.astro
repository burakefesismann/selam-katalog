---
/**
 * İletişim (F2.8): şubeler — adres, telefon (tıklayınca arar), çalışma saatleri, Google Haritalar (yol tarifi).
 * Kurumsal sayfa YOK (K3). Veriler: src/content/ayarlar/genel.yaml (panel: Ayarlar).
 * Arama motorları için LocalBusiness (HardwareStore) yapısal verisi — sadece bilinen alanlarla.
 */
import { Clock, Mail, MapPin, Navigation, Phone } from '@lucide/astro';
import BolumBasligi from '../components/BolumBasligi.astro';
import Buton from '../components/Buton.astro';
import KonumYolu from '../components/KonumYolu.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAyarlar, haritaLinki, telLink } from '../lib/katalog';

const { firma, subeler, ana_sayfa } = await getAyarlar();

const yapisalVeri = {
  '@context': 'https://schema.org',
  '@graph': subeler.map((s) => ({
    '@type': 'HardwareStore',
    name: `${firma.kisa_ad} — ${s.ad}`,
    parentOrganization: { '@type': 'Organization', name: firma.unvan },
    address: { '@type': 'PostalAddress', streetAddress: s.adres, addressRegion: firma.sehir, addressCountry: 'TR' },
    ...(s.telefon ? { telephone: s.telefon } : {}),
    ...(firma.eposta ? { email: firma.eposta } : {}),
    hasMap: haritaLinki(s, firma.kisa_ad),
  })),
};
---

<BaseLayout
  title={`İletişim — ${firma.kisa_ad}`}
  description={`${firma.kisa_ad} şubeleri, adresleri, telefonları ve çalışma saatleri — ${firma.sehir}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(yapisalVeri)} slot="head" />
  <main class="mx-auto max-w-6xl px-4 py-8">
    <KonumYolu ogeler={[{ ad: 'İletişim' }]} />
    <BolumBasligi
      seviye="h1"
      baslik="İletişim"
      aciklama="Ürünler hakkında bilgi almak için arayın ya da mağazalarımıza uğrayın."
    />

    <section class="mb-10 grid gap-4 rounded-lg bg-antrasit p-6 text-white sm:grid-cols-[1fr_auto] sm:items-center sm:p-8">
      <div>
        {ana_sayfa.guven_mesaji && <p class="font-semibold text-turuncu">{ana_sayfa.guven_mesaji}</p>}
        <p class="mt-1 font-baslik text-2xl font-bold text-white sm:text-3xl">{firma.telefon}</p>
        {
          firma.eposta && (
            <a href={`mailto:${firma.eposta}`} class="mt-2 inline-flex items-center gap-2 text-stone-300 hover:text-turuncu">
              <Mail size={18} aria-hidden="true" />
              {firma.eposta}
            </a>
          )
        }
      </div>
      <Buton href={telLink(firma.telefon)} boyut="buyuk">
        <Phone size={20} aria-hidden="true" />
        Hemen arayın
      </Buton>
    </section>

    <h2 class="mb-4 text-2xl">Şubelerimiz</h2>
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        subeler.map((s) => (
          <li class="flex flex-col gap-3 rounded-lg border border-stone-200 bg-white p-5">
            <h3 class="text-xl">{s.ad}</h3>
            <p class="flex gap-2 text-stone-700">
              <MapPin size={20} class="mt-0.5 shrink-0 text-turuncu-koyu" aria-hidden="true" />
              <span>{s.adres}</span>
            </p>
            {s.calisma_saatleri && (
              <p class="flex gap-2 text-stone-700">
                <Clock size={20} class="mt-0.5 shrink-0 text-turuncu-koyu" aria-hidden="true" />
                <span>{s.calisma_saatleri}</span>
              </p>
            )}
            {s.telefon && (
              <p class="flex gap-2">
                <Phone size={20} class="mt-0.5 shrink-0 text-turuncu-koyu" aria-hidden="true" />
                <a href={telLink(s.telefon)} class="font-semibold hover:text-turuncu-koyu hover:underline">
                  {s.telefon}
                </a>
              </p>
            )}
            <div class="mt-auto flex flex-wrap gap-2 pt-2">
              {s.telefon && (
                <Buton href={telLink(s.telefon)} boyut="kucuk">
                  <Phone size={16} aria-hidden="true" />
                  Ara
                </Buton>
              )}
              <Buton href={haritaLinki(s, firma.kisa_ad)} tur="cerceve" boyut="kucuk" target="_blank" rel="noopener">
                <Navigation size={16} aria-hidden="true" />
                Yol tarifi
              </Buton>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-sm text-stone-600">
      {firma.unvan} · {firma.sehir}
    </p>
  </main>
</BaseLayout>
